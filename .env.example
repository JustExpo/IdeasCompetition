# Только для разработки (dev only): значения-заглушки, не использовать за пределами локального стенда.
# `make up` создаёт из этого файла `.env`, если его нет; `.env` в git не попадает.
APP_ENV=dev
# Пароль БД для контейнера db; должен совпадать с паролем в DATABASE_URL.
POSTGRES_PASSWORD=ideas-dev-password
DATABASE_URL=postgresql+asyncpg://ideas:ideas-dev-password@db:5432/ideas
ORGANIZER_EMAIL=organizer@example.com
ORGANIZER_PASSWORD=dev-only-change-me-organizer
ORGANIZER_NAME=Организатор
ALLOWED_EMAIL_DOMAINS=example.com
PUBLIC_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=ideas@example.com
# Необязательные (значения по умолчанию указаны):
# DISPLAY_TZ=Europe/Moscow
# SCHEDULER_INTERVAL_S=15
# LOG_LEVEL=INFO
# LOG_FORMAT=json
