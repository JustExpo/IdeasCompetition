{
  "components": {
    "schemas": {
      "ContestAction": {
        "description": "Действия уровня конкурса; фронт показывает кнопки по ним и не дублирует правила фаз.",
        "enum": [
          "submit_idea",
          "vote",
          "view_results"
        ],
        "title": "ContestAction",
        "type": "string"
      },
      "ContestDetailResponse": {
        "additionalProperties": false,
        "description": "Карточка конкурса: клиент не дублирует правила фаз, а читает `allowed_actions`.",
        "properties": {
          "allowed_actions": {
            "items": {
              "$ref": "#/components/schemas/ContestAction"
            },
            "title": "Allowed Actions",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "phase": {
            "$ref": "#/components/schemas/ContestPhase"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "submission_deadline": {
            "format": "date-time",
            "title": "Submission Deadline",
            "type": "string"
          },
          "tie_break_rule": {
            "default": "Побеждает идея с наибольшим числом голосов. При равенстве голосов побеждает идея, поданная раньше.",
            "title": "Tie Break Rule",
            "type": "string"
          },
          "topic": {
            "title": "Topic",
            "type": "string"
          },
          "voting_deadline": {
            "format": "date-time",
            "title": "Voting Deadline",
            "type": "string"
          }
        },
        "required": [
          "id",
          "topic",
          "description",
          "submission_deadline",
          "voting_deadline",
          "created_at",
          "phase",
          "server_time",
          "allowed_actions"
        ],
        "title": "ContestDetailResponse",
        "type": "object"
      },
      "ContestListResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ContestResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "server_time"
        ],
        "title": "ContestListResponse",
        "type": "object"
      },
      "ContestPhase": {
        "description": "Фаза не хранится в БД, а вычисляется из времени: закрытию раунда нечему «не сработать».",
        "enum": [
          "submission",
          "voting",
          "finished"
        ],
        "title": "ContestPhase",
        "type": "string"
      },
      "ContestResponse": {
        "additionalProperties": false,
        "description": "Конкурс в списке.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "phase": {
            "$ref": "#/components/schemas/ContestPhase"
          },
          "submission_deadline": {
            "format": "date-time",
            "title": "Submission Deadline",
            "type": "string"
          },
          "topic": {
            "title": "Topic",
            "type": "string"
          },
          "voting_deadline": {
            "format": "date-time",
            "title": "Voting Deadline",
            "type": "string"
          }
        },
        "required": [
          "id",
          "topic",
          "description",
          "submission_deadline",
          "voting_deadline",
          "created_at",
          "phase"
        ],
        "title": "ContestResponse",
        "type": "object"
      },
      "CreateContestRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "default": "",
            "maxLength": 50000,
            "title": "Description",
            "type": "string"
          },
          "submission_deadline": {
            "format": "date-time",
            "title": "Submission Deadline",
            "type": "string"
          },
          "topic": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Topic",
            "type": "string"
          },
          "voting_deadline": {
            "format": "date-time",
            "title": "Voting Deadline",
            "type": "string"
          }
        },
        "required": [
          "topic",
          "submission_deadline",
          "voting_deadline"
        ],
        "title": "CreateContestRequest",
        "type": "object"
      },
      "EditIdeaRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "title": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "title",
          "description",
          "version"
        ],
        "title": "EditIdeaRequest",
        "type": "object"
      },
      "FinishedIdeaItem": {
        "additionalProperties": false,
        "description": "Итоги: авторы раскрыты.",
        "properties": {
          "author_name": {
            "title": "Author Name",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_mine": {
            "title": "Is Mine",
            "type": "boolean"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "is_mine",
          "author_name",
          "submitted_at"
        ],
        "title": "FinishedIdeaItem",
        "type": "object"
      },
      "FinishedIdeasResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FinishedIdeaItem"
            },
            "title": "Items",
            "type": "array"
          },
          "phase": {
            "const": "finished",
            "default": "finished",
            "title": "Phase",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "title": "FinishedIdeasResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IdeaResponse": {
        "additionalProperties": false,
        "description": "Своя идея автора: автор знает, что она его, поэтому время подачи и версия показываются.",
        "properties": {
          "contest_id": {
            "title": "Contest Id",
            "type": "integer"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "contest_id",
          "title",
          "description",
          "version",
          "submitted_at",
          "updated_at"
        ],
        "title": "IdeaResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "OwnIdeaItem": {
        "additionalProperties": false,
        "description": "Приём идей: пользователь видит только свои идеи, поэтому версия и время ему известны.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "version",
          "submitted_at",
          "updated_at"
        ],
        "title": "OwnIdeaItem",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 400,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "SubmissionIdeasResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OwnIdeaItem"
            },
            "title": "Items",
            "type": "array"
          },
          "phase": {
            "const": "submission",
            "default": "submission",
            "title": "Phase",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "title": "SubmissionIdeasResponse",
        "type": "object"
      },
      "SubmitIdeaRequest": {
        "additionalProperties": false,
        "properties": {
          "client_request_id": {
            "format": "uuid",
            "title": "Client Request Id",
            "type": "string"
          },
          "description": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "title": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "description",
          "client_request_id"
        ],
        "title": "SubmitIdeaRequest",
        "type": "object"
      },
      "UserResponse": {
        "additionalProperties": false,
        "description": "Профиль вошедшего: своя учётная запись, поэтому e-mail показывается.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VotingIdeaItem": {
        "additionalProperties": false,
        "description": "Голосование: идея без автора и без времени подачи (по нему вычисляется автор).",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_mine": {
            "title": "Is Mine",
            "type": "boolean"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "is_mine"
        ],
        "title": "VotingIdeaItem",
        "type": "object"
      },
      "VotingIdeasResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/VotingIdeaItem"
            },
            "title": "Items",
            "type": "array"
          },
          "phase": {
            "const": "voting",
            "default": "voting",
            "title": "Phase",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "title": "VotingIdeasResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Конкурс идей",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "post_login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "post_logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Post Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
