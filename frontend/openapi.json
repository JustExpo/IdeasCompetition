              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Contest",
        "tags": [
          "contests"
        ]
      }
    },
    "/api/contests/{contest_id}/ideas": {
      "get": {
        "operationId": "get_contest_ideas_api_contests__contest_id__ideas_get",
        "parameters": [
          {
            "in": "path",
            "name": "contest_id",
            "required": true,
            "schema": {
              "title": "Contest Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "finished": "#/components/schemas/FinishedIdeasResponse",
                      "submission": "#/components/schemas/SubmissionIdeasResponse",
                      "voting": "#/components/schemas/VotingIdeasResponse"
                    },
                    "propertyName": "phase"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SubmissionIdeasResponse"
                    },
                    {
                      "$ref": "#/components/schemas/VotingIdeasResponse"
                    },
                    {
                      "$ref": "#/components/schemas/FinishedIdeasResponse"
                    }
                  ],
                  "title": "Response Get Contest Ideas Api Contests  Contest Id  Ideas Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Contest Ideas",
        "tags": [
          "ideas"
        ]
      },
      "post": {
        "operationId": "post_idea_api_contests__contest_id__ideas_post",
        "parameters": [
          {
            "in": "path",
            "name": "contest_id",
            "required": true,
            "schema": {
              "title": "Contest Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitIdeaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Idea",
        "tags": [
          "ideas"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "get_health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Get Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health"
      }
    },
